/*
 * Editorial film-still register. Bodoni Moda for display + numerals,
 * Manrope for body. OKLCH neutrals with a single saturated accent.
 * Asymmetric grid; varied rhythm; numbered sections as the visual motif.
 */

@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,11..96,400..900;1,11..96,400..900&family=Manrope:wght@400;500;600;700&display=swap');

:root {
    --paper:     oklch(0.985 0.005 80);
    --ink:       oklch(0.18  0.01  80);
    --ink-soft:  oklch(0.36  0.01  80);
    --ink-faint: oklch(0.55  0.008 80);
    --rule:      oklch(0.85  0.008 80);
    --rule-soft: oklch(0.92  0.005 80);
    --accent:    oklch(0.46  0.16  25);
    --serif: "Bodoni Moda", "Times New Roman", serif;
    --sans:  "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }

html, body {
    margin: 0;
    padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

main {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 88px) clamp(20px, 4vw, 56px) 96px;
}

/* ============ Header ============ */

.masthead {
    border-bottom: 1px solid var(--rule);
    padding-bottom: clamp(32px, 4vw, 48px);
    margin-bottom: clamp(56px, 6vw, 88px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
}

.eyebrow {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 4px;
}

.masthead h1 {
    font-family: var(--serif);
    font-weight: 700;
    font-optical-sizing: auto;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--ink);
}

.masthead .lede {
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.5;
    color: var(--ink);
    max-width: 56ch;
    margin: 0;
}

.masthead .bio {
    margin: clamp(20px, 2.5vw, 28px) 0 14px;
    padding-top: clamp(20px, 2.5vw, 28px);
    border-top: 1px solid var(--rule-soft);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 58ch;
}

.masthead .bio a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
}

.masthead .bio a:hover {
    border-bottom-color: var(--accent);
    color: var(--accent);
}

.masthead .byline {
    font-size: 13px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    margin: 0;
}

.masthead .byline a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
}

.masthead .byline a:hover {
    border-bottom-color: var(--accent);
    color: var(--accent);
}

/* ============ Hero stat ============ */

.hero-stat {
    margin: clamp(40px, 5vw, 64px) 0 clamp(48px, 6vw, 72px);
    padding: clamp(32px, 4vw, 48px) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    text-align: left;
}

.hero-stat-line {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(26px, 4vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
    color: var(--ink);
    max-width: 22ch;
}

.hero-stat-cap {
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 62ch;
    margin: 0;
}

/* ============ Section labels ============ */

.section-label {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: clamp(64px, 7vw, 96px) 0 clamp(28px, 3vw, 40px);
}

.section-label .num {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(20px, 2vw, 24px);
    color: var(--accent);
    line-height: 1;
    font-variant-numeric: tabular-nums;
}

.section-label h2 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--ink);
}

.section-intro {
    color: var(--ink-soft);
    font-size: 15px;
    max-width: 62ch;
    margin: -4px 0 36px;
    line-height: 1.65;
}

/* ============ Method block ============ */

.method {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    margin-bottom: clamp(56px, 7vw, 88px);
}

.method-label {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-top: 6px;
}

.method-body {
    font-family: var(--sans);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
    max-width: 62ch;
}

/* ============ Per-brand strips ============ */

.strips-list {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-bottom: clamp(48px, 6vw, 80px);
}

.brand-row {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
}

.brand-meta .name {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(16px, 1.4vw, 19px);
    margin: 0 0 4px;
    line-height: 1.2;
    letter-spacing: -0.01em;
}

.brand-meta .sector {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0;
}

.brand-meta .swatch {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    vertical-align: middle;
    margin-right: 8px;
    transform: translateY(-1px);
}

.strip {
    display: block;
    width: 100%;
    height: 68px;
}

.brand-spark {
    margin-top: 10px;
    max-width: 160px;
}

.brand-spark .spark {
    width: 100%;
    height: 28px;
    display: block;
}

/* ============ Sector CI block under scatter ============ */

.sector-ci-block {
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: clamp(20px, 3vw, 28px);
    border-top: 1px solid var(--rule-soft);
}

.ci-eyebrow {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 12px;
}

.ci-note {
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 10px 0 0;
    max-width: 60ch;
}

.sector-ci {
    display: block;
    width: 100%;
    max-width: 760px;
}

/* ============ Polar radial grid ============ */

.radial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: clamp(20px, 2vw, 28px) clamp(16px, 2vw, 24px);
    margin-bottom: clamp(48px, 6vw, 72px);
}

.radial-cell {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.radial-cell .radial {
    width: 100%;
    max-width: 140px;
    height: auto;
    display: block;
}

.radial-cell figcaption {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.radial-cell .rc-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.2;
}

.radial-cell .rc-sector {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
}

/* ============ Dendrogram ============ */

.dendrogram-frame {
    margin: 0;
}

.dendrogram {
    display: block;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
}

/* ============ Pull-quote ============ */

.pull {
    margin: clamp(40px, 5vw, 64px) 0;
    padding: clamp(28px, 4vw, 48px) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
}

.pull-q {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    max-width: 24ch;
}

.pull-q .num {
    color: var(--accent);
    font-weight: 700;
}

.pull-cap {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    margin: 0;
    max-width: 48ch;
}

/* ============ Scatter ============ */

.scatter-frame {
    margin: 0 auto clamp(8px, 1vw, 12px);
    max-width: 620px;
}

.scatter {
    display: block;
    width: 100%;
}

.scatter-cap {
    text-align: center;
    color: var(--ink-soft);
    font-size: 12px;
    letter-spacing: 0.04em;
    margin: 8px 0 0;
    font-family: var(--sans);
}

/* ============ Gap chart ============ */

.gap-frame {
    margin: 0 0 clamp(40px, 5vw, 64px);
}

.gap-chart {
    display: block;
    width: 100%;
    max-width: 760px;
}

/* ============ Patterns ============ */

.patterns {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 5vw, 72px);
    margin-bottom: clamp(48px, 6vw, 80px);
}

.pattern {
    display: grid;
    grid-template-columns: clamp(72px, 8vw, 108px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
}

.pattern .num {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(52px, 6vw, 80px);
    line-height: 0.85;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin: 0;
}

.pattern h3 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(19px, 1.8vw, 23px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: var(--ink);
    max-width: 32ch;
}

.pattern .evidence {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink);
    max-width: 62ch;
}

.pattern .takeaway {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 62ch;
}

.pattern .takeaway strong {
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.02em;
    font-size: 11px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
}

/* ============ Playbook ============ */

.playbook {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 3vw, 40px);
    margin-bottom: clamp(48px, 6vw, 72px);
}

.play {
    display: grid;
    grid-template-columns: clamp(64px, 7vw, 88px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: baseline;
    padding-bottom: clamp(24px, 3vw, 32px);
    border-bottom: 1px solid var(--rule-soft);
}

.play:last-child {
    border-bottom: none;
}

.play .play-num {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(36px, 4.5vw, 56px);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin: 0;
}

.play h3 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0 0 12px;
    color: var(--ink);
    max-width: 36ch;
}

.play .play-body {
    margin: 0;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.65;
    max-width: 62ch;
}

/* ============ Worked example (Air Bank) ============ */

.worked {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 3.5vw, 48px);
    margin-bottom: clamp(48px, 6vw, 72px);
}

.worked-step {
    display: grid;
    grid-template-columns: clamp(64px, 7vw, 88px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: baseline;
    padding-bottom: clamp(28px, 3vw, 36px);
    border-bottom: 1px solid var(--rule-soft);
}

.worked-step:last-child {
    border-bottom: none;
}

.worked-num {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(36px, 4.5vw, 56px);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin: 0;
}

.worked-step h3 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: var(--ink);
    max-width: 40ch;
}

.worked-step p {
    margin: 0 0 12px;
    color: var(--ink);
    font-size: 15px;
    line-height: 1.65;
    max-width: 62ch;
}

.worked-step p:last-child {
    margin-bottom: 0;
}

.worked-step .worked-note {
    color: var(--ink-soft);
    font-size: 14px;
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px solid var(--rule-soft);
}

.worked-step code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.88em;
    background: var(--rule-soft);
    padding: 1px 6px;
    border-radius: 3px;
    color: var(--ink);
}

/* ============ Brief generator picker ============ */

.generator-caveat {
    margin: -16px 0 clamp(20px, 2.5vw, 28px);
    padding: 14px 18px;
    background: oklch(0.96 0.03 80);
    border: 1px solid oklch(0.85 0.06 80);
    border-radius: 3px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 70ch;
}

.generator-caveat strong {
    font-weight: 700;
    color: var(--ink);
}

.generator-controls {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: clamp(20px, 2.5vw, 28px);
    padding: 18px 20px;
    background: var(--rule-soft);
    border-radius: 4px;
}

.generator-label {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
}

.generator-select {
    appearance: none;
    -webkit-appearance: none;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 8px 32px 8px 12px;
    font: inherit;
    font-family: var(--sans);
    font-size: 14px;
    color: var(--ink);
    cursor: pointer;
    flex: 1;
    max-width: 320px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' stroke='%23555' stroke-width='1.5' fill='none'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 10px 7px;
}

.generator-select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
}

.generated-brief:empty {
    display: none;
}

/* ============ Brief artifact (the literal output) ============ */

.brief-artifact {
    margin: clamp(24px, 3vw, 32px) 0 0;
    padding: clamp(28px, 3.5vw, 44px);
    background: oklch(0.98 0.012 80);
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-family: var(--sans);
}

.brief-head {
    margin-bottom: clamp(24px, 3vw, 32px);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
}

.brief-eyebrow {
    margin: 0 0 6px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
}

.brief-title {
    margin: 0;
    font-family: var(--serif);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
}

.brief-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 2.5vw, 32px);
    margin-bottom: clamp(20px, 2.5vw, 28px);
}

.brief-cell {
    min-width: 0;
}

.brief-label {
    margin: 0 0 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
}

.brief-label-warn { color: var(--accent); }
.brief-label-good { color: oklch(0.40 0.10 145); }

.brief-value {
    margin: 0 0 8px;
    font-family: var(--serif);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.2;
    color: var(--ink);
}

.brief-meta {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-soft);
}

.brief-tokens {
    list-style: none;
    padding: 0;
    margin: 0 0 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.brief-tokens li {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 12px;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 4px 10px;
    border-radius: 2px;
    color: var(--ink);
}

.brief-tokens-good li {
    border-color: oklch(0.80 0.05 145);
    background: oklch(0.97 0.02 145);
}

.brief-success {
    margin-top: clamp(20px, 2.5vw, 28px);
    padding-top: clamp(20px, 2.5vw, 24px);
    border-top: 1px solid var(--rule);
}

.brief-success-body {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 64ch;
}

.brief-foot {
    margin-top: clamp(24px, 3vw, 32px);
    padding-top: 14px;
    border-top: 1px solid var(--rule-soft);
}

.brief-foot p {
    margin: 0;
    font-size: 11px;
    line-height: 1.55;
    color: var(--ink-soft);
}

@media (max-width: 640px) {
    .brief-grid { grid-template-columns: 1fr; }
}

/* ============ Appendix (collapsed details) ============ */

.appendix {
    border-top: 1px solid var(--rule);
    padding: clamp(18px, 2.2vw, 26px) 0;
}

.appendix:last-of-type {
    border-bottom: 1px solid var(--rule);
}

.appendix > summary {
    list-style: none;
    cursor: pointer;
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(15px, 1.5vw, 17px);
    color: var(--ink);
    display: flex;
    align-items: baseline;
    gap: 14px;
}

.appendix > summary::-webkit-details-marker { display: none; }

.appendix > summary::before {
    content: "+";
    font-family: var(--serif);
    font-style: normal;
    font-weight: 400;
    font-size: 24px;
    color: var(--accent);
    line-height: 1;
    width: 18px;
    flex-shrink: 0;
}

.appendix[open] > summary::before {
    content: "\2013";
}

.appendix > summary:hover {
    color: var(--accent);
}

.appendix-body {
    margin-top: clamp(20px, 2.5vw, 32px);
    padding-left: 32px;
}

.appendix-lede {
    margin: 0 0 clamp(24px, 3vw, 36px);
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 62ch;
}

@media (max-width: 640px) {
    .appendix-body { padding-left: 0; }
}

.limits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(18px, 2vw, 24px);
}

.limits-list li {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink);
    max-width: 70ch;
    padding-left: 18px;
    position: relative;
}

.limits-list li::before {
    content: "\2014";
    position: absolute;
    left: 0;
    color: var(--ink-faint);
}

.limits-list strong {
    color: var(--ink);
    font-weight: 700;
}

/* ============ Colophon ============ */

footer {
    margin-top: clamp(64px, 8vw, 96px);
    padding-top: 32px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.55;
}

footer h3 {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 8px;
    color: var(--ink);
}

footer p { margin: 0 0 6px; }
footer a { color: var(--ink-soft); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 2px; }
footer a:hover { color: var(--accent); }

/* ============ Responsive ============ */

@media (max-width: 640px) {
    .method,
    .brand-row,
    .pattern,
    .play {
        grid-template-columns: 1fr;
    }
    .method-label {
        padding-top: 0;
    }
    .pattern .num,
    .play .play-num {
        font-size: 40px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}

/* ============ Audio-specific charts ============ */

.split-frame {
    margin: 0 0 8px;
}

.split-chart {
    display: block;
    width: 100%;
    max-width: 800px;
}

.brand-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2vw, 28px);
    margin-bottom: clamp(48px, 6vw, 72px);
}

.brand-card-row {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule-soft);
}

.brand-card-row:last-child {
    border-bottom: none;
}

.audio-card {
    display: block;
    width: 100%;
    max-width: 720px;
    height: 36px;
}

.tempo-frame {
    margin: 0 0 clamp(28px, 4vw, 40px);
}

.tempo-hist {
    display: block;
    width: 100%;
    max-width: 760px;
}

.mode-block {
    margin-top: clamp(28px, 3vw, 36px);
    padding-top: clamp(20px, 3vw, 28px);
    border-top: 1px solid var(--rule-soft);
}

.mode-panel {
    display: block;
    width: 100%;
    max-width: 760px;
}

@media (max-width: 640px) {
    .brand-card-row {
        grid-template-columns: 1fr;
    }
}

/* ============ Strategic topography map ============ */

.map-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
    margin: 0 auto;
    max-width: 1100px;
}

.map-frame {
    margin: 0;
    max-width: 760px;
    text-align: center;
}

.cluster-group {
    cursor: pointer;
    transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.cluster-group:focus {
    outline: none;
}

.cluster-group.is-dimmed {
    opacity: 0.18;
}

.cluster-group.is-active .cluster-label {
    font-size: 16px;
    opacity: 1;
}

.cluster-panel {
    position: sticky;
    top: 24px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 22px 22px 18px;
    font-family: var(--sans);
    min-height: 140px;
}

.cluster-panel-hint {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-soft);
}

.cluster-panel-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
}

.cluster-panel-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    flex-shrink: 0;
}

.cluster-panel-name {
    margin: 0;
    font-family: var(--serif);
    font-style: normal;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.15;
    color: var(--ink);
}

.cluster-panel-meta {
    margin: 0 0 18px;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
}

.cluster-panel-label {
    margin: 14px 0 6px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
}

.cluster-panel-brands {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink);
}

.cluster-panel-tokens {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.cluster-panel-token {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 12px;
    background: var(--rule-soft);
    color: var(--ink);
    padding: 3px 8px;
    border-radius: 3px;
}

.cluster-panel-close {
    appearance: none;
    background: none;
    border: 0;
    margin-top: 16px;
    padding: 0;
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    cursor: pointer;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
}

.cluster-panel-close:hover {
    color: var(--ink);
}

@media (max-width: 880px) {
    .map-wrap { grid-template-columns: 1fr; }
    .cluster-panel { position: static; }
}

.topo-map {
    display: block;
    width: 100%;
    height: auto;
    max-width: 720px;
    margin: 0 auto;
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
    background: var(--paper);
}

.legend-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px 20px;
    margin: clamp(20px, 3vw, 28px) 0 clamp(28px, 4vw, 40px);
}

.legend-chip {
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

.legend-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 2px;
    border: 1px solid #181818;
}

.legend-meta { display: flex; flex-direction: column; gap: 2px; }

.legend-name {
    margin: 0;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
}

.legend-brands {
    margin: 0;
    font-size: 11px;
    color: var(--ink-soft);
    line-height: 1.4;
}

/* ============ Opportunity table ============ */

.opp-table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 clamp(40px, 5vw, 64px);
    font-family: var(--sans);
}

.opp-table thead th {
    text-align: left;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 10px 8px;
    border-bottom: 1px solid var(--ink);
}

.opp-table .num-col {
    text-align: right;
    font-variant-numeric: tabular-nums;
}

.opp-table tbody td {
    padding: 12px 8px;
    border-bottom: 1px solid var(--rule-soft);
    font-size: 14px;
    color: var(--ink);
    vertical-align: top;
}

.opp-table tbody tr:last-child td {
    border-bottom: none;
}

.opp-trend {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.005em;
    max-width: 28ch;
}

.opp-nearby {
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.5;
}

.opp-sim {
    color: var(--ink-faint);
    font-size: 11px;
    margin-left: 3px;
    font-variant-numeric: tabular-nums;
}

.opp-low-conf td {
    color: var(--ink-faint);
}

.opp-low-conf .opp-trend {
    color: var(--ink-soft);
    font-style: normal;
}

.low-conf-badge,
.low-conf-inline {
    display: inline-block;
    font-family: var(--sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 7px;
    border: 1px solid var(--ink-faint);
    border-radius: 999px;
    color: var(--ink-faint);
    vertical-align: middle;
    margin-left: 8px;
    font-style: normal;
}

.low-conf-inline {
    margin: 0 2px;
}

@media (max-width: 720px) {
    .opp-table tbody td { padding: 10px 4px; font-size: 12px; }
    .opp-trend { font-size: 13px; }
    .legend-strip { grid-template-columns: 1fr; }
}

em, i { font-style: normal; font-weight: 600; }

<script id="brief-data" type="application/json">{{ brief_data_json | safe }}</script>
<script>
(function() {
    const dataEl = document.getElementById("brief-data");
    const picker = document.getElementById("brief-brand-picker");
    const out = document.getElementById("generated-brief");
    if (!dataEl || !picker || !out) return;
    const briefs = JSON.parse(dataEl.textContent);
    const brandNames = Object.keys(briefs).sort();
    brandNames.forEach(b => {
        const opt = document.createElement("option");
        opt.value = b;
        opt.textContent = b;
        picker.appendChild(opt);
    });

    function clear(node) { while (node.firstChild) node.removeChild(node.firstChild); }
    function el(tag, opts) {
        const node = document.createElement(tag);
        if (opts && opts.cls) node.className = opts.cls;
        if (opts && opts.text != null) node.textContent = opts.text;
        return node;
    }
    function tokenList(tokens, goodClass) {
        const ul = el("ul", { cls: goodClass ? "brief-tokens brief-tokens-good" : "brief-tokens" });
        tokens.forEach(t => {
            const li = el("li");
            li.textContent = t;
            ul.appendChild(li);
        });
        return ul;
    }

    function renderBrief(brand) {
        clear(out);
        const b = briefs[brand];
        if (!b) return;
        const card = el("aside", { cls: "brief-artifact" });
        card.setAttribute("aria-label", brand + " homepage repositioning brief");

        const head = el("header", { cls: "brief-head" });
        head.appendChild(el("p", { cls: "brief-eyebrow", text: "HOMEPAGE REPOSITIONING BRIEF · 1 PAGE" }));
        head.appendChild(el("p", { cls: "brief-title", text: b.brand }));
        card.appendChild(head);

        // Where you are / Where you need to go
        const row1 = el("div", { cls: "brief-grid" });
        const c1 = el("div", { cls: "brief-cell" });
        c1.appendChild(el("p", { cls: "brief-label", text: "Where you are now" }));
        c1.appendChild(el("p", { cls: "brief-value", text: b.current_cluster + " neighborhood" }));
        const peersText = b.peers.length
            ? "Sharing your homepage template with: " + b.peers.join(", ")
            : "No other brand currently sits in this neighborhood.";
        c1.appendChild(el("p", { cls: "brief-meta", text: peersText }));
        row1.appendChild(c1);

        const c2 = el("div", { cls: "brief-cell" });
        c2.appendChild(el("p", { cls: "brief-label", text: "Where the map points next" }));
        c2.appendChild(el("p", { cls: "brief-value", text: "Edge of " + b.target_cluster.toLowerCase() }));
        const targetParts = [];
        if (b.realistic.length) targetParts.push("Realistic target neighbors: " + b.realistic.join(", "));
        if (b.aspirational.length) targetParts.push("Aspirational direction, not destination: " + b.aspirational.join(", "));
        if (b.avoid.length) targetParts.push("Not the goal: " + b.avoid.join(", "));
        c2.appendChild(el("p", { cls: "brief-meta", text: targetParts.join(". ") + "." }));
        row1.appendChild(c2);
        card.appendChild(row1);

        // Drop / Adopt
        const row2 = el("div", { cls: "brief-grid" });
        const d1 = el("div", { cls: "brief-cell" });
        d1.appendChild(el("p", { cls: "brief-label brief-label-warn", text: "DROP from your homepage" }));
        d1.appendChild(tokenList(b.drop_tokens, false));
        d1.appendChild(el("p", { cls: "brief-meta", text: "Top TF-IDF tokens of your current neighborhood. Some may be brand names — those are the cluster's signature; treat the rest as the institutional/categorical vocabulary you're carrying." }));
        row2.appendChild(d1);

        const d2 = el("div", { cls: "brief-cell" });
        d2.appendChild(el("p", { cls: "brief-label brief-label-good", text: "ADOPT on your homepage" }));
        d2.appendChild(tokenList(b.adopt_tokens, true));
        d2.appendChild(el("p", { cls: "brief-meta", text: "Top TF-IDF tokens of your nearest neighboring neighborhood. The target isn't the centroid of that cluster — it's the edge near " + (b.realistic[0] || "your nearest peer") + ", which sits in the target neighborhood without becoming its loudest archetype." }));
        row2.appendChild(d2);
        card.appendChild(row2);

        // Success metric
        const succ = el("div", { cls: "brief-success" });
        succ.appendChild(el("p", { cls: "brief-label", text: "Success metric" }));
        const succBody = "Re-embed the homepage 90 days post-launch. The " + b.brand + " circle must move off the " + b.current_cluster + " centroid and toward the boundary — the target is the edge between " + b.current_cluster + " and " + b.target_cluster + ", where " + (b.realistic.join(" and ") || "the nearest edge brands") + " sits. Meaningful drift, not full migration. If the circle hasn't moved at all, the brand didn't move — the campaign moved.";
        succ.appendChild(el("p", { cls: "brief-success-body", text: succBody }));
        card.appendChild(succ);

        const foot = el("footer", { cls: "brief-foot" });
        foot.appendChild(el("p", { text: "Generated from the strategic topography map. Token lists come from cluster TF-IDF; trajectory targets come from each brand's nearest non-current cluster and the brands in it ranked by 2D distance. Read alongside the Limits block in the appendix." }));
        card.appendChild(foot);

        out.appendChild(card);
    }

    picker.addEventListener("change", e => {
        if (e.target.value) renderBrief(e.target.value);
        else clear(out);
    });
})();
</script>

<script id="cluster-panel-data" type="application/json">{{ cluster_panel_json | safe }}</script>
<script>
(function() {
    const dataEl = document.getElementById("cluster-panel-data");
    if (!dataEl) return;
    const clusters = JSON.parse(dataEl.textContent);
    const byId = new Map(clusters.map(c => [String(c.id), c]));
    const panel = document.getElementById("cluster-panel");
    const map = document.querySelector(".topo-map");
    if (!panel || !map) return;

    const groups = Array.from(map.querySelectorAll(".cluster-group"));

    function clear(node) { while (node.firstChild) node.removeChild(node.firstChild); }
    function el(tag, opts) {
        const node = document.createElement(tag);
        if (opts && opts.cls) node.className = opts.cls;
        if (opts && opts.text != null) node.textContent = opts.text;
        return node;
    }

    function renderPanel(c) {
        clear(panel);
        const header = el("div", { cls: "cluster-panel-head" });
        const dot = el("span", { cls: "cluster-panel-dot" });
        dot.style.background = c.color;
        header.appendChild(dot);
        header.appendChild(el("p", { cls: "cluster-panel-name", text: c.name }));
        panel.appendChild(header);

        panel.appendChild(el("p", { cls: "cluster-panel-meta", text: c.brands.length + " brands in this neighborhood" }));

        const brandsLabel = el("p", { cls: "cluster-panel-label", text: "Brands" });
        panel.appendChild(brandsLabel);
        const brandList = el("p", { cls: "cluster-panel-brands", text: c.brands.join(", ") });
        panel.appendChild(brandList);

        const tokensLabel = el("p", { cls: "cluster-panel-label", text: "Top TF-IDF tokens" });
        panel.appendChild(tokensLabel);
        const tokens = el("ul", { cls: "cluster-panel-tokens" });
        c.top_tokens.forEach(tok => {
            const li = el("li", { cls: "cluster-panel-token", text: tok });
            tokens.appendChild(li);
        });
        panel.appendChild(tokens);

        const closeBtn = el("button", { cls: "cluster-panel-close", text: "Clear selection" });
        closeBtn.type = "button";
        closeBtn.addEventListener("click", clearSelection);
        panel.appendChild(closeBtn);
    }

    function selectCluster(cid) {
        const c = byId.get(String(cid));
        if (!c) return;
        groups.forEach(g => {
            const active = g.getAttribute("data-cluster-id") === String(cid);
            g.classList.toggle("is-active", active);
            g.classList.toggle("is-dimmed", !active);
        });
        renderPanel(c);
    }

    function clearSelection() {
        groups.forEach(g => {
            g.classList.remove("is-active");
            g.classList.remove("is-dimmed");
        });
        clear(panel);
        panel.appendChild(el("p", { cls: "cluster-panel-hint", text: "Click a neighborhood on the map to see which brands share it and which words define it." }));
    }

    groups.forEach(g => {
        const cid = g.getAttribute("data-cluster-id");
        g.addEventListener("click", () => selectCluster(cid));
        g.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                selectCluster(cid);
            }
        });
    });
})();
</script>

</body>
</html>
